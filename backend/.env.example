# Copy to .env and fill in your values

# Meta (Facebook, Instagram, Threads) - create at developers.facebook.com
META_APP_ID=
META_APP_SECRET=

# LinkedIn - create at developer.linkedin.com
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Public base URL for serving media (needed for Instagram/Threads image posts)
# Use ngrok or your own domain: e.g., https://your-domain.com
# Leave blank if you only post to Facebook, Bluesky, LinkedIn, or text-only Threads
PUBLIC_MEDIA_BASE_URL=

# OAuth callback base (change if not running locally)
OAUTH_CALLBACK_BASE=http://localhost:8000
FRONTEND_URL=http://localhost:5173
