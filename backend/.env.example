# Copy to .env and fill in your values

# Meta (Facebook, Instagram, Threads) - create at developers.facebook.com
META_APP_ID=
META_APP_SECRET=

# LinkedIn - create at developer.linkedin.com
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Public base URL for serving media (needed for Instagram/Threads image posts)
# Use ngrok or your own domain: e.g., https://your-domain.com
# Leave blank if you only post to Facebook, Bluesky, LinkedIn, or text-only Threads
PUBLIC_MEDIA_BASE_URL=

# OAuth callback base — set to your public domain when deploying via Docker
# e.g. https://your-domain.com
# For local dev these defaults are fine:
OAUTH_CALLBACK_BASE=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# --- Docker deployment only ---
# Override where the database and uploads are stored inside the container.
# These are already set correctly in docker-compose.yml; only change if needed.
# DB_PATH=/data/vibepost.db
# UPLOADS_DIR=/data/uploads
