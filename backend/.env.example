# vibepost environment variables
#
# For local development you don't need this file at all — the defaults work.
# Copy to .env and fill in values only when deploying to a public server.
#
# API keys (Meta, LinkedIn, etc.) and other credentials are entered through
# the Settings page in the app and stored in the database — not here.

# The public URL of your server. OAuth providers redirect back to this after
# the user authorises the app. Must match the redirect URI you registered in
# your developer app settings.
# OAUTH_CALLBACK_BASE=https://your-domain.com

# Where to send the browser after the OAuth callback completes.
# FRONTEND_URL=https://your-domain.com

# Override storage locations (already set correctly in docker-compose.yml).
# DB_PATH=/data/vibepost.db
# UPLOADS_DIR=/data/uploads
