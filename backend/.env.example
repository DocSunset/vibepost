# vibepost environment variables
#
# For local development you don't need this file at all — the defaults work.
# Copy to .env and fill in values only when deploying to a public server.
#
# Platform API keys (Meta, LinkedIn, etc.) are entered per-user through the
# app's Settings page and stored in the database — not here.

# REQUIRED in production. Signs session cookies. Generate with:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
# SECRET_KEY=

# "production" enforces SECRET_KEY, marks cookies Secure (HTTPS only),
# enables HSTS, and disables the interactive API docs.
# VIBEPOST_ENV=production

# The public URL of your server. OAuth providers redirect back to this after
# the user authorises the app; it is also the default base for public media
# URLs. Must match the redirect URIs registered in users' developer apps.
# OAUTH_CALLBACK_BASE=https://your-domain.com

# Where to send the browser after the OAuth callback completes.
# FRONTEND_URL=https://your-domain.com

# Comma-separated allowed CORS origins. Leave unset in production when the
# backend serves the frontend itself (same origin, no CORS needed).
# CORS_ORIGINS=

# Serve the built frontend from this directory (single-container deploy).
# FRONTEND_DIST=/app/static

# Override storage locations (already set correctly in docker-compose.yml
# and fly.toml).
# DB_PATH=/data/vibepost.db
# UPLOADS_DIR=/data/uploads

# Session lifetime in seconds (default 7 days).
# SESSION_TTL_SECONDS=604800

# Default invite expiry in days (default 14).
# INVITE_TTL_DAYS=14

# Transactional email (sign-in links). Create a Resend account, verify your
# domain (SPF + DKIM DNS records), then set both of these. Without an API
# key, sign-in links are printed to the server log instead of emailed.
# RESEND_API_KEY=re_...
# EMAIL_FROM=vibepost <login@your-domain>

# How long an emailed sign-in link stays valid (seconds). Default 15 minutes.
# LOGIN_LINK_TTL_SECONDS=900

# WebAuthn relying party id for passkeys. Defaults to the hostname of
# FRONTEND_URL, which is almost always what you want.
# WEBAUTHN_RP_ID=your-domain
