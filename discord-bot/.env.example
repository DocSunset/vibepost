# vibepost feedback bot configuration. Copy to .env and fill in.
# See README.md for where each value comes from.

# Bot token from https://discord.com/developers/applications
# (your app -> Bot -> Reset Token). Revocable there in one click.
DISCORD_TOKEN=

# A dedicated low-limit Anthropic API key from https://console.anthropic.com
# (don't reuse a key that has other duties).
ANTHROPIC_API_KEY=

# Right-click the channel in Discord (with Developer Mode on) -> Copy Channel ID.
FEEDBACK_CHANNEL_ID=

# Your own Discord user ID (right-click your name -> Copy User ID).
# Security escalations are DM'd here; budget alerts ping it.
ADMIN_USER_ID=

# Optional: channel for the nightly digest. Unset = no digest.
DIGEST_CHANNEL_ID=

# Optional: fine-grained GitHub PAT with Issues read/write on the repo below.
# Unset = feedback is summarized into the thread instead of filed.
GITHUB_TOKEN=
GITHUB_REPO=DocSunset/vibepost

# Cost guardrails (defaults shown).
#ANTHROPIC_MODEL=claude-haiku-4-5-20251001
#MAX_TOKENS=600
#HOURLY_CALL_BUDGET=30
#DIGEST_HOUR_UTC=13
